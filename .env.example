# Porta em que a API vai rodar
PORT=3001

# Conexão com o banco PostgreSQL (Prisma)
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
DATABASE_URL="postgresql://postgres:sua_senha@localhost:5432/senai_flow_db?schema=public"

# Chave secreta para assinatura dos Tokens JWT
JWT_SECRET="sua_chave_secreta_aqui"

# (Opcional) Ambiente de execução: development, production ou test
NODE_ENV="development"_