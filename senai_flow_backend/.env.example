# Porta em que a API vai rodar
PORT=3001

# Conexão com o banco PostgreSQL (Prisma)
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
DATABASE_URL="postgresql://postgres:sua_senha@localhost:5432/senai_flow_db?schema=public"

# Chave secreta para assinatura dos Tokens JWT
JWT_SECRET="sua_chave_secreta_aqui"

# (Opcional) Ambiente de execução: development, production ou test
NODE_ENV="development"

# SMTP para envio dos links de recuperação (não use credenciais reais neste arquivo)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="SENAI Flow <no-reply@example.com>"

# URL da tela que recebe o token; em celular, use um host acessível na rede local
PASSWORD_RESET_URL="http://localhost:3000/redefinir-senha"