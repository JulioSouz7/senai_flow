generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================= 1. USUÁRIOS & PERFIS =========================

model Usuario {
  id_usuario     Int      @id @default(autoincrement())
  nome           String   @db.VarChar(150)
  email          String   @unique @db.VarChar(150)
  senha          String   @db.VarChar(100)
  senha_alterada Boolean  @default(false)
  perfil         String   @db.VarChar(30) // ALUNO | DOCENTE | ADMINISTRADOR
  status         String   @default("ATIVO") @db.VarChar(30) // ATIVO | BLOQUEADO

  docente        Docente?
  aluno          Aluno?
  administrador  Administrador?
  relatos        RelatoSugestao[]
  chamados       ChamadoSuporte[]

  @@map("USUARIO")
}

model Docente {
  id_docente Int    @id @default(autoincrement())
  id_usuario Int    @unique
  nif        String @unique @db.VarChar(30) // ver observação sobre ambiguidade de "nif" na resposta

  usuario           Usuario            @relation(fields: [id_usuario], references: [id_usuario])
  docente_turma     DocenteTurma[]
  reserva_docente   ReservaDocente[]
  trocas_sugeridas  TrocaSala[]
  solicitacoes      SolicitacaoEquipamento[]
  avarias           Avaria[]

  @@map("DOCENTE")
}

model Aluno {
  id_aluno   Int    @id @default(autoincrement())
  id_usuario Int    @unique
  matricula  String @unique @db.VarChar(30)
  situacao   String @default("MATRICULADO") @db.VarChar(30) // MATRICULADO | DESMATRICULADO | FORMADO
  id_turma   Int

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario])
  turma   Turma   @relation(fields: [id_turma], references: [id_turma])

  @@map("ALUNO")
}

model Administrador {
  id_adm     Int @id @default(autoincrement())
  id_usuario Int @unique

  usuario              Usuario                @relation(fields: [id_usuario], references: [id_usuario])
  areas_risco          AreaRisco[]
  reservas_validadas   Reserva[]
  trocas_validadas      TrocaSala[]
  solicitacoes_analisadas SolicitacaoEquipamento[]
  comunicados          Comunicado[]
  relatos_analisados   RelatoSugestao[]
  chamados_responsavel ChamadoSuporte[]
  chamados_historico   ChamadoHistorico[]

  @@map("ADMINISTRADOR")
}

// ===================== 2. INFRAESTRUTURA & ESPAÇOS =====================

model Predio {
  id_predio Int    @id @default(autoincrement())
  nome      String @db.VarChar(50)

  salas       Sala[]
  areas_risco AreaRisco[]

  @@map("PREDIO")
}

model Sala {
  id_sala     Int     @id @default(autoincrement())
  id_predio   Int
  nome        String  @db.VarChar(50)
  capacidade  Int
  ativa       Boolean @default(true)
  qr_code     String  @unique @db.VarChar(255)

  predio           Predio             @relation(fields: [id_predio], references: [id_predio])
  sala_equipamento SalaEquipamento[]
  reservas         Reserva[]
  avarias          Avaria[]
  trocas_origem    TrocaSala[] @relation("TrocaSalaOrigem")
  trocas_destino   TrocaSala[] @relation("TrocaSalaDestino")

  @@map("SALA")
}

model Equipamento {
  id_equipamento Int    @id @default(autoincrement())
  nome           String @db.VarChar(100)
  descricao      String? @db.VarChar(255)
  nif            String @unique @db.VarChar(30) // código de barras físico do equipamento
  status         String @default("DISPONIVEL") @db.VarChar(20) // DISPONIVEL | MANUTENCAO | INATIVO

  sala_equipamento SalaEquipamento[]
  itens_solicitacao ItemSolicitacao[]
  avarias          Avaria[]

  @@map("EQUIPAMENTO")
}

model SalaEquipamento {
  id_sala        Int
  id_equipamento Int
  quantidade     Int

  sala        Sala        @relation(fields: [id_sala], references: [id_sala])
  equipamento Equipamento @relation(fields: [id_equipamento], references: [id_equipamento])

  @@id([id_sala, id_equipamento])
  @@map("SALA_EQUIPAMENTO")
}

model AreaRisco {
  id_area              Int    @id @default(autoincrement())
  id_predio            Int
  id_adm               Int
  nome                 String @db.VarChar(100)
  tipo                 String @db.VarChar(50)
  orientacao_seguranca String @db.VarChar(255)
  andar                Int

  predio        Predio        @relation(fields: [id_predio], references: [id_predio])
  administrador Administrador @relation(fields: [id_adm], references: [id_adm])

  @@map("AREA_RISCO")
}

// ========================= 3. GESTÃO ACADÊMICA =========================

model Turma {
  id_turma              Int    @id @default(autoincrement())
  nome                  String @db.VarChar(50)
  curso                 String @db.VarChar(100)
  qtd_alunos            Int    @default(0)
  carga_horaria_semanal Int

  alunos         Aluno[]
  docente_turma  DocenteTurma[]
  reservas       Reserva[]
  pontuacoes     Pontuacao[]
  comunicados    Comunicado[]

  @@map("TURMA")
}

model DocenteTurma {
  id_docente Int
  id_turma   Int

  docente Docente @relation(fields: [id_docente], references: [id_docente])
  turma   Turma   @relation(fields: [id_turma], references: [id_turma])

  @@id([id_docente, id_turma])
  @@map("DOCENTE_TURMA")
}

// ===================== 4. RESERVAS & AGENDAMENTOS =====================

model Reserva {
  id_reserva              Int       @id @default(autoincrement())
  id_sala                 Int
  id_turma                Int
  id_admin                Int?
  tipo                    String    @default("NORMAL") @db.VarChar(50) // NORMAL | URGENCIA
  status                  String    @default("PENDENTE") @db.VarChar(50) // PENDENTE | CONFIRMADA | RECUSADA | CANCELADA | ENCERRADA
  dt_solicitacao          DateTime  @default(now())
  dt_validacao            DateTime?
  justificativa_urgencia  String?   @db.VarChar(255)
  id_reserva_urgencia     Int?
  dt_encerramento         DateTime?
  sala_em_ordem           Boolean?
  obs_encerramento        String?   @db.VarChar(255)

  sala              Sala      @relation(fields: [id_sala], references: [id_sala])
  turma             Turma     @relation(fields: [id_turma], references: [id_turma])
  administrador     Administrador? @relation(fields: [id_admin], references: [id_adm])
  reserva_urgencia  Reserva?  @relation("ReservaUrgencia", fields: [id_reserva_urgencia], references: [id_reserva])
  reservas_afetadas Reserva[] @relation("ReservaUrgencia")

  reserva_docente       ReservaDocente[]
  reserva_horario       ReservaHorario[]
  trocas_sala           TrocaSala[]
  pontuacao             Pontuacao?
  solicitacoes_equip    SolicitacaoEquipamento[]
  avarias               Avaria[]
  comunicados           Comunicado[]

  @@map("RESERVA")
}

model ReservaDocente {
  id_reserva_docente Int @id @default(autoincrement())
  id_reserva         Int
  id_docente         Int

  reserva Reserva @relation(fields: [id_reserva], references: [id_reserva])
  docente Docente @relation(fields: [id_docente], references: [id_docente])

  @@unique([id_reserva, id_docente]) // adicionado além do dicionário: evita duplicidade do mesmo docente na mesma reserva
  @@map("RESERVA_DOCENTE")
}

model ReservaHorario {
  id_horario Int      @id @default(autoincrement())
  id_reserva Int
  data       DateTime @db.Date
  hora_inicio DateTime @db.Time()
  hora_fim    DateTime @db.Time()

  reserva Reserva @relation(fields: [id_reserva], references: [id_reserva])

  @@map("RESERVA_HORARIO")
}

model TrocaSala {
  id_troca              Int      @id @default(autoincrement())
  id_reserva            Int
  id_sala_origem        Int
  id_sala_destino       Int
  id_docente_solicitante Int?
  id_coordenador        Int?
  status                String   @default("PENDENTE") @db.VarChar(30) // PENDENTE | ACEITA | RECUSADA
  motivo                String   @db.VarChar(255)
  dt_troca              DateTime @default(now())

  reserva             Reserva        @relation(fields: [id_reserva], references: [id_reserva])
  sala_origem         Sala           @relation("TrocaSalaOrigem", fields: [id_sala_origem], references: [id_sala])
  sala_destino        Sala           @relation("TrocaSalaDestino", fields: [id_sala_destino], references: [id_sala])
  docente_solicitante Docente?       @relation(fields: [id_docente_solicitante], references: [id_docente])
  coordenador         Administrador? @relation(fields: [id_coordenador], references: [id_adm])

  @@map("TROCA_SALA")
}

model Pontuacao {
  id_pontuacao    Int    @id @default(autoincrement())
  id_reserva      Int    @unique
  id_turma        Int
  pontos          Int
  semestre_letivo String @db.VarChar(20)

  reserva Reserva @relation(fields: [id_reserva], references: [id_reserva])
  turma   Turma   @relation(fields: [id_turma], references: [id_turma])

  @@map("PONTUACAO")
}

// ===================== 5. SOLICITAÇÃO DE EQUIPAMENTOS =====================

model SolicitacaoEquipamento {
  id_solicitacao   Int       @id @default(autoincrement())
  id_reserva       Int
  id_docente       Int
  id_admin_analise Int?
  status           String    @default("PENDENTE") @db.VarChar(50) // PENDENTE | APROVADA | RECUSADA
  dt_solicitacao   DateTime  @default(now())
  dt_resposta      DateTime?

  reserva        Reserva        @relation(fields: [id_reserva], references: [id_reserva])
  docente        Docente        @relation(fields: [id_docente], references: [id_docente])
  admin_analise  Administrador? @relation(fields: [id_admin_analise], references: [id_adm])
  itens          ItemSolicitacao[]

  @@map("SOLICITACAO_EQUIPAMENTO")
}

model ItemSolicitacao {
  id_item_solicitacao Int @id @default(autoincrement())
  id_solicitacao      Int
  id_equipamento      Int
  quantidade          Int

  solicitacao SolicitacaoEquipamento @relation(fields: [id_solicitacao], references: [id_solicitacao])
  equipamento Equipamento            @relation(fields: [id_equipamento], references: [id_equipamento])

  @@map("ITEM_SOLICITACAO")
}

// ===================== 6. OCORRÊNCIAS & MANUTENÇÃO =====================

model Avaria {
  id_avaria      Int    @id @default(autoincrement())
  id_docente     Int
  id_sala        Int
  id_equipamento Int?
  id_reserva     Int?
  descricao      String @db.VarChar(255) // CHECK LENGTH >= 30, ver migration.sql
  foto           String @db.VarChar(255)
  gravidade      String @db.VarChar(30) // BAIXA | MEDIA | ALTA
  status         String @default("ENCAMINHADO") @db.VarChar(30) // ENCAMINHADO | EM_ANALISE | FINALIZADO

  docente     Docente      @relation(fields: [id_docente], references: [id_docente])
  sala        Sala         @relation(fields: [id_sala], references: [id_sala])
  equipamento Equipamento? @relation(fields: [id_equipamento], references: [id_equipamento])
  reserva     Reserva?     @relation(fields: [id_reserva], references: [id_reserva])

  @@map("AVARIA")
}

// ===================== 7. COMUNICAÇÃO & SUPORTE =====================

model Comunicado {
  id_comunicado Int      @id @default(autoincrement())
  id_adm        Int
  id_turma      Int?
  id_reserva    Int?
  titulo        String   @db.VarChar(255)
  conteudo      String   @db.VarChar(255)
  abrangencia   String   @db.VarChar(20) // GERAL | TURMA
  publico_alvo  String?  @db.VarChar(255)
  dt_publicacao DateTime @default(now())

  administrador Administrador @relation(fields: [id_adm], references: [id_adm])
  turma         Turma?        @relation(fields: [id_turma], references: [id_turma])
  reserva       Reserva?      @relation(fields: [id_reserva], references: [id_reserva])

  @@map("COMUNICADO")
}

model RelatoSugestao {
  id_relato               Int       @id @default(autoincrement())
  id_usuario              Int
  tipo                    String    @db.VarChar(20) // RECLAMACAO | SUGESTAO | APONTAMENTO
  descricao               String    @db.VarChar(255)
  dt_envio                DateTime  @default(now())
  prazo_resposta          DateTime? @db.Date
  status                  String    @default("PENDENTE") @db.VarChar(20) // PENDENTE | LIDO | ARQUIVADO
  id_admin                Int?
  resposta                String?   @db.VarChar(255)
  encaminhada_corporativo Boolean   @default(false)

  usuario Usuario        @relation(fields: [id_usuario], references: [id_usuario])
  admin   Administrador? @relation(fields: [id_admin], references: [id_adm])

  @@map("RELATOS_SUGESTOES")
}

model ChamadoSuporte {
  id_chamado    Int      @id @default(autoincrement())
  id_usuario    Int
  id_admin_resp Int?
  assunto       String   @db.VarChar(255)
  descricao     String   @db.VarChar(255)
  status        String   @default("ABERTO") @db.VarChar(20) // ABERTO | EM_ANDAMENTO | RESOLVIDO
  dt_abertura   DateTime @default(now())

  usuario    Usuario            @relation(fields: [id_usuario], references: [id_usuario])
  admin_resp Administrador?     @relation(fields: [id_admin_resp], references: [id_adm])
  historico  ChamadoHistorico[]

  @@map("CHAMADO_SUPORTE")
}

model ChamadoHistorico {
  id_historico    Int      @id @default(autoincrement())
  id_chamado      Int
  id_admin_status Int
  observacao      String?  @db.VarChar(255)
  dt_registro     DateTime @default(now())

  chamado      ChamadoSuporte @relation(fields: [id_chamado], references: [id_chamado])
  admin_status Administrador  @relation(fields: [id_admin_status], references: [id_adm])

  @@map("CHAMADO_HISTORICO")
}

model Faq {
  id_faq    Int     @id @default(autoincrement())
  pergunta  String  @db.VarChar(255)
  resposta  String  @db.VarChar(255)
  categoria String? @db.VarChar(50)

  @@map("FAQ")
}
