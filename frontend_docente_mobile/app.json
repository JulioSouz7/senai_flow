{
  "expo": {
    "name": "SENAI Flow",
    "slug": "senai-flow-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/senai-flow-icon.png",
    "scheme": "senaiflow",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E30613",
        "foregroundImage": "./assets/images/senai-flow-adaptive.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/senai-flow-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E30613",
          "image": "./assets/images/senai-flow-adaptive.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
