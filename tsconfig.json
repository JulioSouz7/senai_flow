{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "typeRoots": ["./node_modules/@types", "./src/@types"],
    "lib": ["es2022"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "prisma/**/*", "src/@types/**/*"],
}